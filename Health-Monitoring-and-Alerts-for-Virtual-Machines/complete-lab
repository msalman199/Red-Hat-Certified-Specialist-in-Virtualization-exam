Subtask 3.4: Create Custom Health Check Script
Step 1: Create a comprehensive VM health check script

# Create health check script on Monitor Server
sudo tee /opt/vm_health_check.sh > /dev/null <<'EOF'
#!/bin/bash

# VM Health Check Script
# This script checks the health of monitored VMs

PROMETHEUS_URL="http://localhost:9090"
LOG_FILE="/var/log/vm_health_check.log"

echo "$(date): Starting VM Health Check" | tee -a $LOG_FILE

# Function to query Prometheus
query_prometheus() {
    local query="$1"
    curl -s "${PROMETHEUS_URL}/api/v1/query?query=${query}" | jq -r '.data.result[]'
}

# Check VM availability
echo "Checking VM availability..." | tee -a $LOG_FILE
vm_status=$(query_prometheus "up{job=\"vm-health-monitoring\"}")
echo "$vm_status" | jq -r '"VM: " + .metric.instance + " Status: " + (.value[1] | if . == "1" then "UP" else "DOWN" end)' | tee -a $LOG_FILE

# Check CPU usage
echo "Checking CPU usage..." | tee -a $LOG_FILE
cpu_usage=$(query_prometheus "100 - (avg by(instance) (irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)")
echo "$cpu_usage" | jq -r '"VM: " + .metric.instance + " CPU: " + (.value[1] | tonumber | floor | tostring) + "%"' | tee -a $LOG_FILE

# Check Memory usage
echo "Checking Memory usage..." | tee -a $LOG_FILE
mem_usage=$(query_prometheus "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100")
echo "$mem_usage" | jq -r '"VM: " + .metric.instance + " Memory: " + (.value[1] | tonumber | floor | tostring) + "%"' | tee -a $LOG_FILE

# Check active alerts
echo "Checking active alerts..." | tee -a $LOG_FILE
active_alerts=$(curl -s "${PROMETHEUS_URL}/api/v1/alerts" | jq -r '.data.alerts[] | select(.state=="firing") | "ALERT: " + .labels.alertname + " on " + .labels.instance + " - " + .annotations.summary')

if [ -n "$active_alerts" ]; then
    echo "$active_alerts" | tee -a $LOG_FILE
else
    echo "No active alerts" | tee -a $LOG_FILE
fi

echo "$(date): VM Health Check completed" | tee -a $LOG_FILE
echo "----------------------------------------" | tee -a $LOG_FILE
EOF

# Make script executable
sudo chmod +x /opt/vm_health_check.sh
Step 2: Run the health check script

# Run health check
sudo /opt/vm_health_check.sh

# View the log
sudo cat /var/log/vm_health_check.log
Step 3: Set up cron job for regular health checks

# Add cron job to run health check every 5 minutes
