Task 2: Set Up Alerting for VM Status Changes
Subtask 2.1: Configure Alertmanager
Step 1: Create Alertmanager configuration file

# Create alertmanager configuration
sudo tee /etc/alertmanager/alertmanager.yml > /dev/null <<EOF
global:
  smtp_smarthost: 'localhost:587'
  smtp_from: 'alertmanager@yourdomain.com'

route:
  group_by: ['alertname']
  group_wait: 10s
  group_interval: 10s
  repeat_interval: 1h
  receiver: 'vm-alerts'

receivers:
- name: 'vm-alerts'
  webhook_configs:
  - url: 'http://localhost:5001/webhook'
    send_resolved: true

inhibit_rules:
  - source_match:
      severity: 'critical'
    target_match:
      severity: 'warning'
    equal: ['alertname', 'dev', 'instance']
EOF
Step 2: Start and enable Alertmanager

