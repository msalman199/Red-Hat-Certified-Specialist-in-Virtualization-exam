Subtask 3.3: Set Up Automated Monitoring
Step 1: Configure SNMP Monitoring
Enable SNMP on the RHVH host:

# On RHVH host
dnf install net-snmp net-snmp-utils -y
systemctl enable snmpd
systemctl start snmpd
Configure SNMP community string:

cat > /etc/snmp/snmpd.conf << 'EOF'
com2sec readonly default public
group readgroup v2c readonly
view all included .1 80
access readgroup "" any noauth exact all none none
EOF

systemctl restart snmpd
Step 2: Configure Log Monitoring
Set up centralized logging:

# Configure rsyslog for remote logging
cat >> /etc/rsyslog.conf << 'EOF'
*.* @@rhvm-server-ip:514
EOF

systemctl restart rsyslog
Step 3: Create Monitoring Scripts
Create automated monitoring scripts:

cat > /usr/local/bin/host_monitor.sh << 'EOF'
#!/bin/bash

# Host monitoring script
HOST_NAME=$(hostname)
TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')

# Check CPU usage
CPU_USAGE=$(top -bn1 | grep "Cpu(s)" | awk '{print $2}' | cut -d'%' -f1)

# Check memory usage
MEM_USAGE=$(free | grep Mem | awk '{printf("%.2f", $3/$2 * 100.0)}')

# Check disk usage
DISK_USAGE=$(df -h / | awk 'NR==2{print $5}' | cut -d'%' -f1)

# Log metrics
echo "$TIMESTAMP - Host: $HOST_NAME, CPU: ${CPU_USAGE}%, Memory: ${MEM_USAGE}%, Disk: ${DISK_USAGE}%" >> /var/log/host_metrics.log

# Send alerts if thresholds exceeded
if (( $(echo "$CPU_USAGE > 80" | bc -l) )); then
    logger "HIGH CPU USAGE ALERT: $CPU_USAGE%"
fi

if (( $(echo "$MEM_USAGE > 85" | bc -l) )); then
    logger "HIGH MEMORY USAGE ALERT: $MEM_USAGE%"
fi
EOF

chmod +x /usr/local/bin/host_monitor.sh
Step 4: Schedule Monitoring Tasks
Add monitoring script to crontab:

# Run monitoring script every 5 minutes
echo "*/5 * * * * /usr/local/bin/host_monitor.sh" | crontab -
