Subtask 3.3: Automate VM Deployment with Scripts
Let's create scripts to automate the deployment and configuration process.

Create a deployment script:
sudo tee /usr/local/bin/deploy-from-template.sh << 'EOF'
#!/bin/bash

# VM Deployment Script
# Usage: deploy-from-template.sh <template-name> <new-vm-name> <environment>

TEMPLATE_NAME=$1
NEW_VM_NAME=$2
ENVIRONMENT=$3

if [ $# -ne 3 ]; then
    echo "Usage: $0 <template-name> <new-vm-name> <environment>"
    echo "Example: $0 lamp-template web-server-prod-03 production"
    exit 1
fi

echo "Deploying VM: $NEW_VM_NAME from template: $TEMPLATE_NAME"

# Clone the VM
virt-clone \
  --original "$TEMPLATE_NAME" \
  --name "$NEW_VM_NAME" \
  --file "/var/lib/libvirt/images/${NEW_VM_NAME}.qcow2"

if [ $? -eq 0 ]; then
    echo "VM $NEW_VM_NAME cloned successfully"
    
    # Start the VM
    virsh start "$NEW_VM_NAME"
    
    echo "VM $NEW_VM_NAME started"
    echo "Remember to:"
    echo "1. Connect to the VM: virsh console $NEW_VM_NAME"
    echo "2. Set hostname: hostnamectl set-hostname $NEW_VM_NAME"
    echo "3. Regenerate SSH keys: ssh-keygen -A"
    echo "4. Configure application settings"
else
    echo "Failed to clone VM"
    exit 1
fi
EOF
