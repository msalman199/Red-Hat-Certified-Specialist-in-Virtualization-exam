Create template backup script:
sudo tee /usr/local/bin/backup-templates.sh << 'EOF'
#!/bin/bash

BACKUP_DIR="/backup/vm-templates"
TEMPLATE_DIR="/var/lib/libvirt/templates"
DATE=$(date +%Y%m%d_%H%M%S)

mkdir -p "$BACKUP_DIR"

echo "Backing up VM templates to $BACKUP_DIR"

for template in "$TEMPLATE_DIR"/*.qcow2; do
    if [ -f "$template" ]; then
        template_name=$(basename "$template" .qcow2)
        echo "Backing up $template_name..."
        
        # Create compressed backup
        gzip -c "$template" > "$BACKUP_DIR/${template_name}_${DATE}.qcow2.gz"
        
        if [ $? -eq 0 ]; then
            echo "✓ $template_name backed up successfully"
        else
            echo "✗ Failed to backup $template_name"
        fi
    fi
done

# Backup template metadata
cp -r "$TEMPLATE_DIR"/*.md "$TEMPLATE_DIR"/*.json "$BACKUP_DIR/" 2>/dev/null

echo "Template backup completed: $BACKUP_DIR"
EOF
